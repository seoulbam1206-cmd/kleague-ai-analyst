# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 절대 GitHub 에 올리지 않습니다)

# 수집기용 설정(수집 키·수집 계정)은 이 공개 저장소에 없다. 앱은 DB 를 읽기만 한다.

# --- 앱 ---
# 질문 실행용: SELECT 전용 계정 (db/tidb_setup.sql 의 kl_query_ro)
QUERY_DB_URL=mysql://[접두어].kl_query_ro:[비밀번호]@[호스트]:4000/kleague
# 로그·피드백 저장용 (kl_app_rw)
APP_DB_URL=mysql://[접두어].kl_app_rw:[비밀번호]@[호스트]:4000/kleague

# LLM: OpenAI gpt-oss-120b(오픈 모델)를 Groq 추론 서비스로 호출 (OpenAI 호환 API, 무료 티어 기본값)
LLM_API_KEY=발급받은_LLM_키
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Gemini 무료 티어를 쓰려면:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

DAILY_TOKEN_BUDGET=90000
# 분당 토큰 한도 (Groq 무료 티어 gpt-oss-120b = 8000). 평가 실행기가 이 안에서 질문을 보냄
LLM_TPM=8000
# 추론 강도 (low/medium/high). 비우면 서비스 기본값. low 는 응답이 빠르지만 정답률 확인 필요
LLM_REASONING_EFFORT=
