# Streamlit Community Cloud → 앱 Settings → Secrets 에 아래 6줄을 붙여넣고 [ ] 부분을 채우세요.
# (이 예시 파일에는 실제 값을 쓰지 않습니다. 순서: docs/DEPLOY.md)
#
# 넣지 않는 것: 수집 계정, 수집용 키 – 앱은 DB 를 읽기만 합니다.
# 계정은 db/tidb_setup.sql 로 만든 것: 질문 = kl_query_ro(SELECT 전용), 로그 = kl_app_rw(app_ 표만)
# 비밀번호에 @ / : 같은 문자가 있으면 퍼센트 인코딩 (예: @ → %40)

QUERY_DB_URL = "mysql://[접두어].kl_query_ro:[비밀번호]@[호스트]:4000/kleague"
APP_DB_URL = "mysql://[접두어].kl_app_rw:[비밀번호]@[호스트]:4000/kleague"
LLM_API_KEY = "[Groq 키]"
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "openai/gpt-oss-120b"
DAILY_TOKEN_BUDGET = "90000"

# 선택: 접속 코드. Sharing 으로 비공개 전환이 안 될 때만 (docs/DEPLOY.md 4-1). 실제 코드는 여기에 쓰지 않는다.
# ACCESS_CODE = "[길고 추측하기 어려운 코드]"

# 선택: 생성된 SQL 을 볼 관리자 이메일 (쉼표로 구분). 아래는 가짜 값 – 실제 주소는 Secrets 에만 쓴다.
# ADMIN_EMAILS = "admin@example.invalid"
# 선택: 관리자 코드 (이메일을 읽을 수 없을 때의 보조 방법). 실제 코드는 Secrets 에만 쓴다.
# ADMIN_CODE = "[길고 추측하기 어려운 코드]"
